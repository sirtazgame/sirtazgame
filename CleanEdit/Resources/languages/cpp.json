{
  "name": "C++",
  "extensions": ["cpp", "cc", "cxx", "hpp", "h", "hh", "c"],
  "lineComment": "//",
  "blockCommentStart": "/*",
  "blockCommentEnd": "*/",
  "stringDelimiters": ["\"", "'"],
  "functionCalls": true,
  "keywords": [
    "alignas", "alignof", "and", "and_eq", "asm", "auto", "bitand", "bitor",
    "break", "case", "catch", "class", "compl", "concept", "const", "consteval",
    "constexpr", "constinit", "const_cast", "continue", "co_await", "co_return",
    "co_yield", "decltype", "default", "delete", "do", "dynamic_cast", "else",
    "enum", "explicit", "export", "extern", "false", "for", "friend", "goto",
    "if", "inline", "mutable", "namespace", "new", "noexcept", "not", "not_eq",
    "nullptr", "operator", "or", "or_eq", "private", "protected", "public",
    "register", "reinterpret_cast", "requires", "return", "sizeof", "static",
    "static_assert", "static_cast", "struct", "switch", "template", "this",
    "thread_local", "throw", "true", "try", "typedef", "typeid", "typename",
    "union", "using", "virtual", "volatile", "while", "xor", "xor_eq"
  ],
  "types": [
    "int", "float", "double", "char", "char8_t", "char16_t", "char32_t",
    "bool", "void", "long", "short", "unsigned", "signed", "wchar_t",
    "size_t", "string", "wstring", "vector", "map", "set", "unordered_map",
    "pair", "tuple", "array", "uint8_t", "uint16_t", "uint32_t", "uint64_t",
    "int8_t", "int16_t", "int32_t", "int64_t"
  ],
  "rules": [
    { "pattern": "^\\s*#\\s*[A-Za-z_]+", "type": "keyword", "multiline": true }
  ]
}
