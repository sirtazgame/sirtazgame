{
  "name": "NPA",
  "extensions": ["npa"],
  "lineComment": "#",
  "stringDelimiters": ["\"", "'"],
  "keywords": ["true", "false", "null", "on", "off", "yes", "no", "define", "end"],
  "types": ["node", "point", "path", "vector", "group"],
  "rules": [
    { "pattern": "^\\s*\\[[^\\]]+\\]", "type": "heading", "multiline": true },
    { "pattern": "^\\s*[A-Za-z_][\\w.-]*(?=\\s*[:=])", "type": "attribute", "multiline": true },
    { "pattern": "@[A-Za-z_][\\w]*", "type": "function", "multiline": true }
  ]
}
