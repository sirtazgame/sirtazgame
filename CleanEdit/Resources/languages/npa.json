{
  "name": "NPA",
  "extensions": ["npa"],
  "lineComment": "##",
  "rules": [
    { "pattern": "^[ \\t]*[><].*$", "type": "function", "multiline": true },
    { "pattern": "\\[[A-Za-z_][A-Za-z0-9_]*\\]", "type": "keyword" },
    { "pattern": "\\[[0-9]+\\]", "type": "attribute" },
    { "pattern": "\\.\\.\\.", "type": "border" }
  ]
}
