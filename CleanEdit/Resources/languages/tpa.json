{
  "name": "TPA",
  "extensions": ["tpa"],
  "lineComment": "^ ",
  "rules": [
    { "pattern": "^[ \\t]*##=+##[ \\t]*$", "type": "border", "multiline": true },
    { "pattern": "^[ \\t]*>>", "type": "keyword", "multiline": true },
    { "pattern": "^[ \\t]*>[ \\t].*$", "type": "heading", "multiline": true }
  ]
}
